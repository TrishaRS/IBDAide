<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ rules: cloud Auto Backup (E2E-encrypted with device PIN on Android 9+)
     and device-to-device transfer (covers Samsung Smart Switch). FR-14a. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="scan_photos" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="scan_photos" />
    </device-transfer>
</data-extraction-rules>
